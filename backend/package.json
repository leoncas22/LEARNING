{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "LMS Platform - Backend API (Express + Prisma + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:init-roles": "node prisma/init-system-roles.js",
    "db:restore-admin": "node prisma/restore-dev-admin.js",
    "db:reset": "prisma migrate reset",
    "test:activity:validation": "node test_activity_validation.mjs",
    "test:activity": "node test_activity_features.mjs",
    "test:auth:validation": "node test_auth_registration_validation.mjs",
    "test:system-role-init": "node test_system_role_initialization.mjs",
    "test:reporting": "node --test test_reporting_aggregation.mjs test_reporting_contract.mjs",
    "test:platform-admin": "node --test test_platform_admin_contract.mjs",
    "test:security-hardening": "node --test test_security_hardening_contract.mjs",
    "test:security-hardening:integration": "node test_security_hardening.integration.mjs",
    "test": "node --test test_*.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
