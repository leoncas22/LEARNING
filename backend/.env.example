# --- App ---
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# --- Database connection ---
DATABASE_URL="postgresql://user:LeonardoCalv22@localhost:5432/lms_platform?schema=public"

# --- JWT ---
# JWT_ACCESS_SECRET signs the short-lived access token (a real JWT).
# JWT_REFRESH_SECRET is NOT used to sign a JWT — it's the HMAC key used to
# hash opaque refresh/reset/verification tokens before they're stored (see
# src/utils/token.js). Generate both with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies (refresh token) ---
# Set COOKIE_SECURE=true and COOKIE_SAME_SITE=none only when served over
# HTTPS in production. Keep false/lax for local HTTP development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- File Storage ---
# STORAGE_DRIVER=local | s3 | supabase
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# S3 / Supabase (used when STORAGE_DRIVER != local)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
